---
import '../styles/components/nav.css';

interface Props {
  locale?: 'en';
  /** 英文頁對應的中文頁路徑；有值時在英文導覽列加「中文」切換連結 */
  zhPath?: string;
  /** 中文頁對應的英文頁路徑；有值時在中文導覽列加「English」切換連結 */
  enPath?: string;
}

const { locale, zhPath, enPath } = Astro.props;
const en = locale === 'en';

const links = en
  ? [
      { path: '/en/works', label: 'Works' },
      { path: '/en/explore', label: 'Explore' },
      { path: '/en/exam', label: 'Exams' },
      { path: '/en/concept', label: 'Concepts' },
      { path: '/en/about', label: 'About' },
    ]
  : [
      { path: '/works', label: '作品集' },
      { path: '/explore', label: '主題導覽' },
      { path: '/exam', label: '試題視覺化' },
      { path: '/concept', label: '概念' },
      { path: '/about', label: '關於' },
    ];
const menuLabels = en
  ? { open: 'Open menu', close: 'Close menu' }
  : { open: '開啟選單', close: '關閉選單' };

const pathname = Astro.url.pathname;

function isActivePath(path: string, current: string): boolean {
  if (path === '/') return current === '/';
  return current === path || current.startsWith(`${path}/`);
}
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a href={en ? '/en/' : '/'} class="site-nav__logo">羊·實驗</a>

    <button
      class="site-nav__menu-button"
      type="button"
      aria-label={menuLabels.open}
      aria-expanded="false"
      aria-controls="site-nav-links"
      data-nav-toggle
      data-label-open={menuLabels.open}
      data-label-close={menuLabels.close}
    >
      <span class="site-nav__hamburger" aria-hidden="true">
        <span />
        <span />
        <span />
      </span>
    </button>

    <nav
      id="site-nav-links"
      class="site-nav__links"
      aria-label={en ? 'Main navigation' : '主要導覽'}
      data-nav-links
      data-open="false"
    >
      {
        links.map((link) => (
          <a
            href={link.path}
            class:list={['site-nav__link', { 'is-active': isActivePath(link.path, pathname) }]}
          >
            {link.label}
          </a>
        ))
      }
      {
        en && zhPath ? (
          <a href={zhPath} class="site-nav__link" hreflang="zh-Hant" lang="zh-Hant">
            中文
          </a>
        ) : null
      }
      {
        !en && enPath ? (
          <a href={enPath} class="site-nav__link" hreflang="en" lang="en">
            English
          </a>
        ) : null
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement | null;
  const links = document.querySelector('[data-nav-links]') as HTMLElement | null;

  const setOpen = (open: boolean) => {
    if (!links) return;
    links.dataset.open = open ? 'true' : 'false';
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    const label = open ? toggle?.dataset.labelClose : toggle?.dataset.labelOpen;
    if (label) toggle?.setAttribute('aria-label', label);
  };

  toggle?.addEventListener('click', () => {
    if (!links) return;
    setOpen(links.dataset.open !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (links?.dataset.open !== 'true') return;
    setOpen(false);
    toggle?.focus();
  });

  document.addEventListener('click', (event) => {
    if (!links || !toggle || links.dataset.open !== 'true') return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (links.contains(target) || toggle.contains(target)) return;
    setOpen(false);
  });
</script>

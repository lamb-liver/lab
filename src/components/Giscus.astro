---
import '../styles/components/comments.css';

interface Props {
  locale?: 'en';
}

const en = Astro.props.locale === 'en';
---

<section
  class="page-comments"
  aria-label={en ? 'Comments' : '留言'}
  data-giscus-lang={en ? 'en' : 'zh-TW'}
>
  <h2 class="page-comments__title">{en ? 'Comments' : '留言'}</h2>
  <p class="page-comments__hint">{en ? 'Comment with a GitHub account.' : '用 GitHub 帳號留言。'}</p>
  <div class="page-comments__host" data-giscus-host>
    <button type="button" class="page-comments__load" data-giscus-load>
      {en ? 'Load comments' : '載入留言'}
    </button>
  </div>
</section>

<script>
  import { GISCUS, giscusDiscussionTerm } from '../lib/siteOps';

  function loadGiscus(host: HTMLElement) {
    if (host.dataset.loaded) return;
    host.dataset.loaded = 'true';
    host.querySelector('[data-giscus-load]')?.remove();
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.setAttribute('data-repo', GISCUS.repo);
    script.setAttribute('data-repo-id', GISCUS.repoId);
    script.setAttribute('data-category', GISCUS.category);
    script.setAttribute('data-category-id', GISCUS.categoryId);
    script.setAttribute('data-mapping', 'specific');
    script.setAttribute('data-term', giscusDiscussionTerm(window.location.pathname));
    script.setAttribute('data-strict', '1');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'bottom');
    script.setAttribute('data-theme', 'transparent_dark');
    const section = host.closest('.page-comments');
    const lang =
      section instanceof HTMLElement && section.dataset.giscusLang
        ? section.dataset.giscusLang
        : 'zh-TW';
    script.setAttribute('data-lang', lang);
    script.setAttribute('data-loading', 'lazy');
    host.appendChild(script);
  }

  const host = document.querySelector('[data-giscus-host]');
  if (host instanceof HTMLElement) {
    const load = () => loadGiscus(host);
    host.querySelector('[data-giscus-load]')?.addEventListener('click', load);
    const section = document.querySelector('.page-comments');
    if (section && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          io.disconnect();
          load();
        },
        { rootMargin: '240px' },
      );
      io.observe(section);
    }
  }
</script>

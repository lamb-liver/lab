---
import '../styles/components/filter.css';

interface Props {
  options: string[];
  ariaLabel: string;
  /** 按鈕文字；沒給時直接顯示篩選值 */
  labels?: Record<string, string>;
  allLabel?: string;
}

const { options, ariaLabel, labels = {}, allLabel = '全部' } = Astro.props;
const items = [allLabel, ...options];
---

<div class="filter-scroll" data-filter-scroll>
  <div class="filter-bar" data-filter-bar role="group" aria-label={ariaLabel}>
    {
      items.map((item, i) => (
        <button
          type="button"
          class:list={['filter-btn', { 'is-active': i === 0 }]}
          data-filter-value={i === 0 ? '*' : item}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {i === 0 ? item : (labels[item] ?? item)}
        </button>
      ))
    }
  </div>
</div>

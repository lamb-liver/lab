---
import '../styles/components/card.css';
import '../styles/components/section-badge.css';
import CardThumbFallback from './CardThumbFallback.astro';
import type { ContestDifficulty, ContestDomain } from '../content.config';

interface Props {
  slug: string;
  title: string;
  description: string;
  domain: ContestDomain;
  difficulty: ContestDifficulty;
  estimatedMinutes: number;
  coverImage?: string;
  featured?: boolean;
}

const {
  slug,
  title,
  description,
  domain,
  difficulty,
  estimatedMinutes,
  coverImage,
  featured = false,
} = Astro.props;
---

<article class:list={['card', 'card--contest', { 'card--featured': featured }]}>
  <a href={`/contest/${slug}`} class="card__link-wrap">
    <span class="card__kind card__kind--contest">競賽研題</span>
    <div class="card__thumb" aria-hidden="true">
      {
        coverImage ? (
          <img src={coverImage} alt="" class="card__thumb-cover" loading="lazy" decoding="async" />
        ) : (
          <CardThumbFallback />
        )
      }
    </div>
    <div class="card__body">
      <div class="card__title-row">
        <h3 class="card__title">{title}</h3>
        {featured ? <span class="card__featured-label">精選</span> : null}
      </div>
      <div class="card__tags">
        <span class="card__tag">{domain}</span>
        <span class="card__tag">{difficulty}</span>
        <span class="card__tag">約 {estimatedMinutes} 分鐘</span>
      </div>
      <p class="card__desc">{description}</p>
    </div>
  </a>
</article>

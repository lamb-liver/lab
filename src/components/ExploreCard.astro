---
import '../styles/components/card.css';
import CardThumbFallback from './CardThumbFallback.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  /** zh 為 ExploreCategory／ContentAudience；英文頁用英文 md 的字串 */
  category: string;
  audience: string;
  coverImage?: string;
  featured?: boolean;
  locale?: 'en';
}

const {
  slug,
  title,
  description,
  category,
  audience,
  coverImage,
  featured = false,
  locale,
} = Astro.props;
const en = locale === 'en';
---

<article
  class:list={['card', 'card--explore', { 'card--featured': featured }]}
  data-filter-item
  data-filter-category={category}
  data-content-audience={audience}
  data-search-slug={slug}
>
  <a href={en ? `/en/explore/${slug}/` : `/explore/${slug}`} class="card__link-wrap">
    <span class="card__kind card__kind--explore">{en ? 'Interactive' : '互動視覺化'}</span>
    <div class="card__thumb" aria-hidden="true">
      {
        coverImage ? (
          <img
            src={coverImage}
            alt=""
            class="card__thumb-cover"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <CardThumbFallback />
        )
      }
    </div>
    <div class="card__body">
      <div class="card__title-row">
        <h3 class="card__title">{title}</h3>
        {featured ? <span class="card__featured-label">{en ? 'Featured' : '精選'}</span> : null}
      </div>
      <div class="card__tags">
        <span class="card__tag">{category}</span>
        <span class="card__tag" data-audience-label>{audience}</span>
      </div>
      <p class="card__desc">{description}</p>
    </div>
  </a>
</article>

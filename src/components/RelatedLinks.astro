---
import '../styles/components/related-links.css';
import type { RelatedRef } from '../lib/relatedContent';

interface Props {
  items: RelatedRef[];
  heading?: string;
  ariaLabel?: string;
}

const { items, heading = '延伸', ariaLabel = '延伸閱讀' } = Astro.props;

const kindPrefix: Record<RelatedRef['kind'], string> = {
  work: '作品：',
  explore: '主題導覽：',
  exam: '試題：',
};
---

{
  items.length > 0 ? (
    <section class="related-links" aria-label={ariaLabel}>
      <h2>{heading}</h2>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href}>
              {kindPrefix[item.kind]}
              {item.title}
            </a>
            {item.meta ? <span class="related-links__meta">{item.meta}</span> : null}
          </li>
        ))}
      </ul>
    </section>
  ) : null
}

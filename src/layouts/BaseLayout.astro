---
import { nearestCounterpartList } from '../lib/translatedSlugs';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/scrollbar.css';
import '../styles/layout.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Umami from '../components/Umami.astro';
import { DEFAULT_OG_IMAGE, DEFAULT_OG_IMAGE_ALT, isDefaultOgImage } from '../lib/defaultOg';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  structuredData?: Array<Record<string, unknown>>;
  /** 尚未公開的區塊：擋搜尋引擎索引與 sitemap 收錄 */
  noindex?: boolean;
  /** Preload LXGW WenKai TC when the page uses concept / educational prose */
  preloadConceptFont?: boolean;
  htmlLang?: string;
  ogLocale?: string;
  skipLabel?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
}

const {
  title,
  description = '羊·實驗 — 數學與演算法的視覺化實驗',
  ogImage,
  ogImageAlt,
  ogType = 'website',
  structuredData = [],
  noindex = false,
  preloadConceptFont = false,
  htmlLang = 'zh-Hant',
  ogLocale = 'zh_TW',
  skipLabel = '跳至主要內容',
  alternates = [],
} = Astro.props;
const ogLocaleForHreflang: Record<string, string> = {
  en: 'en_US',
  'zh-Hant': 'zh_TW',
};
const ogLocaleAlternates = [
  ...new Set(
    alternates
      .map((alt) => ogLocaleForHreflang[alt.hreflang])
      .filter((value): value is string => Boolean(value) && value !== ogLocale),
  ),
];
const navLocale = htmlLang === 'en' ? 'en' : undefined;
// 語言切換：有對應頁就去對應頁；沒有就去另一語言最近的列表頁，再沒有就去首頁
const counterpartAlternate = alternates.find(
  (alt) => alt.hreflang === (navLocale ? 'zh-Hant' : 'en'),
);
const langTogglePath = counterpartAlternate
  ? new URL(counterpartAlternate.href).pathname
  : nearestCounterpartList(Astro.url.pathname, navLocale);
// 全站語言偏好：只有真的有對應頁時才自動轉址，避免把人丟到列表頁
const langRedirectPath = counterpartAlternate ? langTogglePath : null;
const fullTitle = title === '羊·實驗' ? title : `${title} · 羊·實驗`;
const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname || '/', site).href;
const resolvedOgTitle = fullTitle;
const resolvedOgDescription = description;
const usesDefaultOgImage = isDefaultOgImage(ogImage);
const resolvedOgImagePath = usesDefaultOgImage ? DEFAULT_OG_IMAGE : ogImage!;
const ogImageURL = new URL(resolvedOgImagePath, site).href;
const resolvedOgImageAlt =
  ogImageAlt ?? (usesDefaultOgImage ? DEFAULT_OG_IMAGE_ALT : resolvedOgTitle);
const inferredOgImageSize =
  usesDefaultOgImage || resolvedOgImagePath.startsWith('/og/works/')
    ? { width: 1200, height: 630 }
    : null;
const siteRootURL = new URL('/', site).href;
const siteStructuredData =
  canonicalURL === siteRootURL
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: '羊·實驗',
          url: siteRootURL,
          inLanguage: 'zh-Hant',
        },
      ]
    : [];
const jsonLd = [
  ...siteStructuredData,
  ...structuredData,
].map((data) => JSON.stringify(data).replace(/</g, '\\u003c'));
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ langRedirectPath }}>
      // 一鍵切換全站語言：使用者按過語言切換後，之後進到另一語言的頁面會直接換成對應頁。
      // 只在有對應頁時轉址；爬蟲不轉；按切換鈕時會先寫入新偏好，所以手動切換永遠優先。
      (function () {
        try {
          if (!langRedirectPath) return;
          if (/bot|crawl|spider|slurp|facebookexternalhit|embedly|lighthouse/i.test(navigator.userAgent)) return;
          var here = document.documentElement.lang === 'en' ? 'en' : 'zh-Hant';
          var pref = null;
          try {
            pref = localStorage.getItem('lab-lang');
          } catch (e) {}
          if (!pref) {
            var m = document.cookie.match(/(?:^|;\s*)lab-lang=([^;]+)/);
            pref = m ? decodeURIComponent(m[1]) : null;
          }
          if ((pref !== 'en' && pref !== 'zh-Hant') || pref === here) return;
          var subject = new URLSearchParams(location.search).get('subject');
          var target = langRedirectPath + (subject ? '?subject=' + encodeURIComponent(subject) : '');
          document.documentElement.style.visibility = 'hidden';
          window.addEventListener('pageshow', function () {
            document.documentElement.style.visibility = '';
          });
          location.replace(target);
        } catch (e) {
          document.documentElement.style.visibility = '';
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/lab-favicon-eb-garamond.svg" />
    <link
      rel="preload"
      href="/fonts/noto-sans-tc/NotoSansTC-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/genwanmin-tw/GenWanMin2TW-M.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadConceptFont ? (
        <link
          rel="preload"
          href="/fonts/lxgw-wenkai-tc/LXGWWenKaiTC-Regular.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      ) : null
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonicalURL} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="羊·實驗" />
    <meta property="og:locale" content={ogLocale} />
    {
      ogLocaleAlternates.map((value) => (
        <meta property="og:locale:alternate" content={value} />
      ))
    }
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    {
      inferredOgImageSize ? (
        <>
          <meta property="og:image:width" content={String(inferredOgImageSize.width)} />
          <meta property="og:image:height" content={String(inferredOgImageSize.height)} />
        </>
      ) : null
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    {jsonLd.map((json) => <script type="application/ld+json" set:html={json} />)}
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <Umami />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipLabel}</a>
    <Nav locale={navLocale} langTogglePath={langTogglePath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={navLocale} />
  </body>
</html>

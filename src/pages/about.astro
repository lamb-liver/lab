---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteSeo } from '../lib/seoCopy';
import {
  CONTACT_EMAIL,
  FACEBOOK_URL,
  GITHUB_URL,
  PERSONAL_SITE_HOST,
  PERSONAL_SITE_URL,
  THREADS_HANDLE,
  THREADS_URL,
} from '../lib/siteLinks';
import '../styles/pages/about.css';
---

<BaseLayout title={siteSeo.about.title} description={siteSeo.about.description} ogType="website">
  <div class="container">
    <div class="about-page">
      <header class="page-header">
        <h1>關於</h1>
      </header>

      <section class="about-section">
        <p>
          數學系背景，現為前端與 Android 工程師。此站用程式把數學形狀與演算法做成可調的互動實驗。
        </p>
        <p>
          作品集深挖一個對象；主題導覽串起同一概念的幾種讀法；試題視覺化對準高三考題會卡住的步驟。這裡不是完整課程，而是方便回頭比較形狀的實驗筆記。
        </p>
      </section>

      <section class="about-section about-section--contact">
        <h2>聯絡方式</h2>
        <div class="about-contact">
          <div class="about-contact__row">
            <p class="about-contact__label">Email</p>
            <div class="about-contact__value">
              <a href={`mailto:${CONTACT_EMAIL}`} class="about-contact__link">
                {CONTACT_EMAIL}
              </a>
              <button
                type="button"
                class="about-contact__copy"
                data-copy-email={CONTACT_EMAIL}
                aria-describedby="about-copy-status"
              >
                複製
              </button>
              <span id="about-copy-status" class="about-contact__copy-status" aria-live="polite"
              ></span>
            </div>
          </div>
          <div class="about-contact__row">
            <p class="about-contact__label">其它</p>
            <ul class="about-contact__social">
              <li>
                <a
                  href={PERSONAL_SITE_URL}
                  class="about-contact__link"
                  target="_blank"
                  rel="noopener noreferrer">{PERSONAL_SITE_HOST}</a
                >
              </li>
              <li>
                <a
                  href={GITHUB_URL}
                  class="about-contact__link"
                  target="_blank"
                  rel="noopener noreferrer">GitHub</a
                >
              </li>
              <li>
                <a
                  href={THREADS_URL}
                  class="about-contact__link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Threads ${THREADS_HANDLE}`}>Threads</a
                >
              </li>
              <li>
                <a
                  href={FACEBOOK_URL}
                  class="about-contact__link"
                  target="_blank"
                  rel="noopener noreferrer">Facebook</a
                >
              </li>
            </ul>
          </div>
        </div>
      </section>
    </div>
  </div>
  <script is:inline>
    (function () {
      var button = document.querySelector('[data-copy-email]');
      var status = document.getElementById('about-copy-status');
      if (!button || !status) return;
      var statusTimer = 0;
      var disposed = false;

      function clearStatusTimer() {
        if (!statusTimer) return;
        window.clearTimeout(statusTimer);
        statusTimer = 0;
      }

      function cleanup() {
        disposed = true;
        clearStatusTimer();
      }

      button.addEventListener('click', function () {
        if (disposed) return;
        var email = button.getAttribute('data-copy-email');
        if (!email) return;

        navigator.clipboard
          .writeText(email)
          .then(function () {
            if (disposed) return;
            clearStatusTimer();
            status.textContent = '已複製';
            statusTimer = window.setTimeout(function () {
              if (disposed) return;
              status.textContent = '';
              statusTimer = 0;
            }, 2000);
          })
          .catch(function () {
            if (disposed) return;
            clearStatusTimer();
            status.textContent = '複製失敗，請手動選取';
          });
      });

      window.addEventListener('pagehide', cleanup, { once: true });
    })();
  </script>
</BaseLayout>

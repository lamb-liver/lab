---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WorkCard from '../../components/WorkCard.astro';
import ExploreCard from '../../components/ExploreCard.astro';
import ExamCard from '../../components/ExamCard.astro';
import { conceptBySlug } from '../../lib/concepts';
import { loadConceptIndex } from '../../lib/conceptCollections';
import { conceptHasPage, type ConceptGroup } from '../../lib/conceptIndex';
import '../../styles/components/card.css';
import '../../styles/pages/concept.css';

export async function getStaticPaths() {
  const index = await loadConceptIndex();
  return [...index.entries()]
    .filter(([slug, group]) => conceptBySlug(slug) && conceptHasPage(group))
    .map(([slug, group]) => ({ params: { slug }, props: { slug, group } }));
}

interface Props {
  slug: string;
  group: ConceptGroup;
}

const { slug, group } = Astro.props as Props;
const concept = conceptBySlug(slug)!;
const title = `${concept.label}`;
const description = `與「${concept.label}」相關的作品、主題導覽與試題視覺化，共 ${group.total} 篇。`;

const site = Astro.site ?? Astro.url;
const siteRoot = new URL('/', site).href;
const conceptRoot = new URL('/concept', site).href;
const pageUrl = new URL(`/concept/${slug}`, site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: siteRoot },
      { '@type': 'ListItem', position: 2, name: '概念', item: conceptRoot },
      { '@type': 'ListItem', position: 3, name: concept.label, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} ogType="website" structuredData={structuredData}>
  <div class="container concept-detail">
    <div class="detail-top-nav">
      <Breadcrumb
        items={[
          { label: '首頁', href: '/' },
          { label: '概念', href: '/concept' },
          { label: concept.label },
        ]}
      />
      <a href="/concept" class="back-link back-link--top">← 返回概念索引</a>
    </div>

    <header class="page-header">
      <span class="section-badge">{concept.area}</span>
      <h1>{concept.label}</h1>
      <p class="page-lead">
        橫跨作品集、主題導覽與試題視覺化，共 {group.total} 篇與此概念相關。
      </p>
    </header>

    {
      group.explore.length > 0 && (
        <section class="concept-section" aria-label="主題導覽">
          <h2 class="concept-section__title">主題導覽</h2>
          <div class="card-grid">
            {group.explore.map((entry) => (
              <ExploreCard
                slug={entry.id}
                title={entry.data.title}
                description={entry.data.description}
                category={entry.data.category}
                audience={entry.data.audience}
                coverImage={entry.data.coverImage}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      group.works.length > 0 && (
        <section class="concept-section" aria-label="作品集">
          <h2 class="concept-section__title">作品集</h2>
          <div class="card-grid">
            {group.works.map((entry) => (
              <WorkCard
                slug={entry.id}
                title={entry.data.title}
                description={entry.data.description}
                tags={entry.data.tags}
                audience={entry.data.audience}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      group.exams.length > 0 && (
        <section class="concept-section" aria-label="試題視覺化">
          <h2 class="concept-section__title">試題視覺化</h2>
          <div class="card-grid">
            {group.exams.map((entry) => (
              <ExamCard
                slug={entry.id}
                title={entry.data.title}
                description={entry.data.description}
                subject={entry.data.subject}
                year={entry.data.year}
                questionType={entry.data.questionType}
                questionNo={entry.data.questionNo}
                topics={entry.data.topics}
                coverImage={entry.data.coverImage}
                draft={entry.data.draft}
              />
            ))}
          </div>
        </section>
      )
    }

    <a href="/concept" class="back-link">← 返回概念索引</a>
  </div>
</BaseLayout>

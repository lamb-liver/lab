---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CanvasPlaceholder from '../../components/CanvasPlaceholder.astro';
import ContestInteractiveStage from '../../components/contest/ContestInteractiveStage';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { getCollection, render } from 'astro:content';
import type { RelatedRef } from '../../lib/relatedContent';
import { getCollectionPagerNeighbors, getStaticPathsFromCollection } from '../../content/utils';
import { isContestInteractive } from '../../contest/interactiveRegistry';
import 'katex/dist/katex.min.css';
import '../../styles/components/canvas.css';
import '../../styles/prose.css';
import '../../styles/pages/explore-detail.css';
import '../../styles/pages/contest.css';

export async function getStaticPaths() {
  const contestStudies = await getCollection('contestStudies');
  return getStaticPathsFromCollection(contestStudies, { includeDraft: import.meta.env.DEV });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const interactive = isContestInteractive(entry.id);
const { previous, next } = getCollectionPagerNeighbors(
  await getCollection('contestStudies'),
  entry.id,
);
const source = entry.data.source;
const sourceLabel = [`${source.year} ${source.contest}`, source.round, source.problemNo ? `第 ${source.problemNo} 題` : null]
  .filter(Boolean)
  .join(' · ');
const relatedWorksCollection = await getCollection('works');
const relatedExploreCollection = await getCollection('explore');
const relatedItems: RelatedRef[] = [
  ...entry.data.relatedExplore
    .map((slug) => relatedExploreCollection.find((item) => item.id === slug && !item.data.draft))
    .filter((item) => item !== undefined)
    .map((item) => ({ kind: 'explore' as const, href: `/explore/${item.id}`, title: item.data.title })),
  ...entry.data.relatedWorks
    .map((slug) => relatedWorksCollection.find((item) => item.id === slug && !item.data.draft))
    .filter((item) => item !== undefined)
    .map((item) => ({ kind: 'work' as const, href: `/works/${item.id}`, title: item.data.title })),
];
const site = Astro.site ?? Astro.url;
const siteRoot = new URL('/', site).href;
const contestUrl = new URL('/contest', site).href;
const articleUrl = new URL(`/contest/${entry.id}`, site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: siteRoot },
      { '@type': 'ListItem', position: 2, name: '競賽研題', item: contestUrl },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: articleUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: articleUrl,
    mainEntityOfPage: articleUrl,
    inLanguage: 'zh-Hant',
    datePublished: entry.data.date.toISOString(),
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.coverImage}
  ogImageAlt={entry.data.title}
  ogType="article"
  structuredData={structuredData}
  noindex={entry.data.draft}
>
  <div class={`container contest-detail${interactive ? ' contest-detail--interactive' : ''}`}>
    <div class="detail-top-nav">
      <Breadcrumb
        items={[{ label: '首頁', href: '/' }, { label: '競賽研題', href: '/contest' }, { label: entry.data.title }]}
      />
      <a href="/contest" class="back-link back-link--top">← 返回競賽研題</a>
    </div>

    <header class="page-header">
      <p class="contest-source-label">{sourceLabel}</p>
      <h1>{entry.data.title}</h1>
      <div class="tag-list">
        <span class="tag">{entry.data.domain}</span>
        <span class="tag">{entry.data.difficulty}</span>
        <span class="tag">約 {entry.data.estimatedMinutes} 分鐘</span>
      </div>
      {entry.data.prerequisites.length > 0 ? (
        <p class="content-prerequisites"><strong>建議先備：</strong>{entry.data.prerequisites.join('、')}</p>
      ) : null}
      {source.url ? (
        <p class="contest-source-links">
          <a href={source.url} rel="noopener noreferrer" target="_blank">原題來源</a>
        </p>
      ) : null}
    </header>

    {interactive ? (
      <ContestInteractiveStage client:only="react" slug={entry.id}>
        <div slot="fallback" class="interactive-loading interactive-loading--contest" role="status" aria-live="polite" aria-label="互動內容載入中">
          <span class="interactive-loading__mark"></span>
        </div>
      </ContestInteractiveStage>
    ) : <CanvasPlaceholder class="interactive-canvas" />}

    <article class="prose"><Content /></article>

    <RelatedLinks items={relatedItems} heading="延伸連結" ariaLabel="研題延伸連結" />

    <nav class="explore-detail__pager contest-detail__pager" aria-label="研題文章導覽">
      {previous ? (
        <a href={`/contest/${previous.id}`} class="explore-detail__pager-link">
          <span>較早一題</span><strong>{previous.data.title}</strong>
        </a>
      ) : <span class="explore-detail__pager-link explore-detail__pager-link--disabled"><span>較早一題</span><strong>無</strong></span>}
      {next ? (
        <a href={`/contest/${next.id}`} class="explore-detail__pager-link explore-detail__pager-link--next">
          <span>較新一題</span><strong>{next.data.title}</strong>
        </a>
      ) : <span class="explore-detail__pager-link explore-detail__pager-link--disabled explore-detail__pager-link--next"><span>較新一題</span><strong>無</strong></span>}
    </nav>

    <a href="/contest" class="back-link">← 返回競賽研題</a>
  </div>
</BaseLayout>

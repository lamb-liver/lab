---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContestCard from '../../components/ContestCard.astro';
import { getCollection } from 'astro:content';
import { getPublishedAsc } from '../../content/utils';
import { siteSeo } from '../../lib/seoCopy';
import '../../styles/pages/contest.css';

const all = await getCollection('contestStudies');
const studies = import.meta.env.DEV
  ? [...all].sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
  : getPublishedAsc(all);
const hasPublished = studies.some((entry) => !entry.data.draft);

if (!import.meta.env.DEV && !hasPublished) {
  return Astro.redirect('/');
}
---

<BaseLayout
  title={siteSeo.contest.title}
  description={siteSeo.contest.description}
  ogType="website"
  noindex={!hasPublished}
>
  <div class="container section-scope--contest">
    <header class="page-header">
      <span class="section-badge section-badge--contest">競賽研題</span>
      <h1>競賽研題</h1>
      <p class="page-lead">
        從一題競賽母題出發，拆出背後可遷移的結構、證明與等號位置。
      </p>
    </header>

    <div class="card-grid">
      {studies.map((entry) => (
        <ContestCard
          slug={entry.id}
          title={entry.data.title}
          description={entry.data.description}
          domain={entry.data.domain}
          difficulty={entry.data.difficulty}
          estimatedMinutes={entry.data.estimatedMinutes}
          coverImage={entry.data.coverImage}
          featured={entry.data.featured}
        />
      ))}
    </div>

    {studies.length === 0 ? <p class="contest-empty">研題內容準備中。</p> : null}
  </div>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListSearchFilterScript from '../../../components/ListSearchFilterScript.astro';
import FilterBar from '../../../components/FilterBar.astro';
import WorkCard from '../../../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { collectWorkTags, getPublishedAsc } from '../../../content/utils';
import { serializeSearchIndex } from '../../../lib/listFilter';
import { siteSeoEn } from '../../../lib/seoCopy';
import { enWorkSlugs, indexAlternates } from '../../../lib/translatedSlugs';
import '../../../styles/components/list-search.css';

const works = getPublishedAsc(
  (await getCollection('worksEn')).filter((entry) => enWorkSlugs.has(entry.id)),
);
const tagOptions = collectWorkTags(works, 'en');
const searchIndex = works.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  description: entry.data.description,
}));
const site = Astro.site ?? Astro.url;
---

<BaseLayout
  title={siteSeoEn.works.title}
  description={siteSeoEn.works.description}
  ogType="website"
  htmlLang="en"
  ogLocale="en_US"
  skipLabel="Skip to main content"
  alternates={indexAlternates(site, '/works/')}
>
  <div
    class="container"
    data-list-filter
    data-filter-param="tag"
    data-search-param="q"
    data-search-index-id="works-search-index"
    data-filter-count-unit="works"
    data-filter-count-locale="en"
  >
    <header class="page-header">
      <span class="section-badge section-badge--work">In-depth works</span>
      <h1>Works</h1>
      <p class="page-lead">
        In-depth pieces on single topics. Each focuses on one mathematical object, with the
        formula, an interactive figure, and a visual explanation.
      </p>
    </header>

    <section class="list-controls" aria-label="Work list tools">
      <div class="list-controls__top">
        <div class="list-search">
          <label class="list-search__label" for="works-search-input">Search works</label>
          <input
            id="works-search-input"
            class="list-search__input"
            type="search"
            name="q"
            placeholder="Search titles or descriptions…"
            autocomplete="off"
            spellcheck="false"
            data-works-search-input
            data-list-search-input
          />
        </div>

        <p class="list-filter-count" data-filter-count aria-live="polite">{works.length} works</p>
      </div>

      <FilterBar options={tagOptions} ariaLabel="Filter works by tag" allLabel="All" />
    </section>

    <script
      type="application/json"
      id="works-search-index"
      set:html={serializeSearchIndex(searchIndex)}
    />

    <div class="card-grid" data-card-grid>
      {
        works.map((entry) => (
          <WorkCard
            slug={entry.id}
            title={entry.data.title}
            description={entry.data.description}
            tags={entry.data.tags}
            audience={entry.data.audience}
            locale="en"
          />
        ))
      }
    </div>

    <p class="filter-empty" data-filter-empty hidden>
      No matching works
      <button type="button" class="filter-empty__clear" data-filter-clear>Clear filters</button>
    </p>
  </div>
  <ListSearchFilterScript />
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilterBar from '../../../components/FilterBar.astro';
import ExploreCard from '../../../components/ExploreCard.astro';
import ListSearchFilterScript from '../../../components/ListSearchFilterScript.astro';
import { getCollection } from 'astro:content';
import { collectExploreCategories, getPublishedAsc } from '../../../content/utils';
import { serializeSearchIndex } from '../../../lib/listFilter';
import { siteSeoEn } from '../../../lib/seoCopy';
import { enExploreSlugs, indexAlternates } from '../../../lib/translatedSlugs';
import '../../../styles/components/list-search.css';

const explore = getPublishedAsc(
  (await getCollection('exploreEn')).filter((entry) => enExploreSlugs.has(entry.id)),
);
const categoryOptions = collectExploreCategories(explore, 'en');
const searchIndex = explore.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  description: entry.data.description,
}));
const site = Astro.site ?? Astro.url;
---

<BaseLayout
  title={siteSeoEn.explore.title}
  description={siteSeoEn.explore.description}
  ogType="website"
  htmlLang="en"
  ogLocale="en_US"
  skipLabel="Skip to main content"
  alternates={indexAlternates(site, '/explore/')}
>
  <div
    class="container section-scope--explore"
    data-list-filter
    data-filter-param="category"
    data-search-param="q"
    data-search-index-id="explore-search-index"
    data-filter-count-unit="topics"
    data-filter-count-locale="en"
  >
    <header class="page-header">
      <span class="section-badge section-badge--explore">Interactive</span>
      <h1>Math topics</h1>
      <p class="page-lead">
        From geometry and algebra to analysis and statistics, use interactive visualizations to
        see the core picture of each topic.
      </p>
    </header>

    <section class="list-controls" aria-label="Topic list tools">
      <div class="list-controls__top">
        <div class="list-search">
          <label class="list-search__label" for="explore-search-input">Search topics</label>
          <input
            id="explore-search-input"
            class="list-search__input"
            type="search"
            name="q"
            placeholder="Search titles or descriptions…"
            autocomplete="off"
            spellcheck="false"
            data-list-search-input
          />
        </div>

        <p class="list-filter-count" data-filter-count aria-live="polite">
          {explore.length} topics
        </p>
      </div>

      <FilterBar options={categoryOptions} ariaLabel="Filter topics by category" allLabel="All" />
    </section>

    <script
      type="application/json"
      id="explore-search-index"
      set:html={serializeSearchIndex(searchIndex)}
    />

    <div class="card-grid" data-card-grid>
      {
        explore.map((entry) => (
          <ExploreCard
            slug={entry.id}
            title={entry.data.title}
            description={entry.data.description}
            category={entry.data.category}
            audience={entry.data.audience}
            coverImage={entry.data.coverImage}
            locale="en"
          />
        ))
      }
    </div>

    <p class="filter-empty" data-filter-empty hidden>
      Nothing matches this category yet
      <button type="button" class="filter-empty__clear" data-filter-clear>Clear filters</button>
    </p>
  </div>
  <ListSearchFilterScript />
</BaseLayout>

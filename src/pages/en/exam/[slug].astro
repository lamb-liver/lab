---
import ConceptTags from '../../../components/ConceptTags.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CanvasPlaceholder from '../../../components/CanvasPlaceholder.astro';
import ExamInteractiveStage from '../../../components/exam/ExamInteractiveStage';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Giscus from '../../../components/Giscus.astro';
import FitKatexDisplay from '../../../components/FitKatexDisplay.astro';
import { getCollection, render } from 'astro:content';
import type { RelatedRef } from '../../../lib/relatedContent';
import { getStaticPathsFromCollection } from '../../../content/utils';
import { isExamInteractive } from '../../../exam/interactiveRegistry';
import { SITE_AUTHOR } from '../../../lib/siteLinks';
import { examCreditLine, examSourceLabel, examSourceLinkLabels } from '../../../lib/examSource';
import { enExamSlugs, translationAlternates } from '../../../lib/translatedSlugs';
import 'katex/dist/katex.min.css';
import '../../../styles/components/canvas.css';
import '../../../styles/prose.css';
import '../../../styles/pages/explore-detail.css';
import '../../../styles/pages/exam-detail.css';
import '../../../styles/components/explore-touch.css';
import '../../../styles/components/explore/explore-stage.css';

export async function getStaticPaths() {
  const exam = (await getCollection('examEn')).filter((entry) => enExamSlugs.has(entry.id));
  return getStaticPathsFromCollection(exam, { includeDraft: import.meta.env.DEV });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const interactive = isExamInteractive(entry.id);
const sourceLabel = examSourceLabel(entry.data, 'en');
const sourceLinkLabels = examSourceLinkLabels(entry.data.subject, 'en');
const creditLine = examCreditLine(entry.data, 'en');
const ogImage = entry.data.coverImage;
const site = Astro.site ?? Astro.url;
const siteRoot = new URL('/en/', site).href;
const sectionUrl = new URL('/en/exam/', site).href;
const articleUrl = new URL(`/en/exam/${entry.id}`, site).href;
const imageUrl = ogImage ? new URL(ogImage, site).href : undefined;
const alternates = translationAlternates(site, 'exam', entry.id);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
      { '@type': 'ListItem', position: 2, name: 'Exams', item: sectionUrl },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: articleUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    ...(imageUrl ? { image: imageUrl } : {}),
    url: articleUrl,
    mainEntityOfPage: articleUrl,
    inLanguage: 'en',
    datePublished: entry.data.date.toISOString(),
    author: SITE_AUTHOR,
  },
];

const worksEn = await getCollection('worksEn');
const exploreEn = await getCollection('exploreEn');
const works = await getCollection('works');
const explore = await getCollection('explore');

function related(kind: 'works' | 'explore', slug: string): RelatedRef | undefined {
  const english = (kind === 'works' ? worksEn : exploreEn).find((item) => item.id === slug);
  if (english && (entry.data.draft || !english.data.draft)) {
    return {
      kind: kind === 'works' ? 'work' : 'explore',
      href: `/en/${kind}/${slug}/`,
      title: english.data.title,
    };
  }
  const chinese = (kind === 'works' ? works : explore).find(
    (item) => item.id === slug && (entry.data.draft || !item.data.draft),
  );
  if (!chinese) return undefined;
  return {
    kind: kind === 'works' ? 'work' : 'explore',
    href: `/${kind}/${slug}/`,
    title: chinese.data.title,
  };
}

const relatedItems: RelatedRef[] = [
  ...entry.data.relatedExplore.map((slug) => related('explore', slug)),
  ...entry.data.relatedWorks.map((slug) => related('works', slug)),
].filter((item) => item !== undefined);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImage}
  ogImageAlt={entry.data.title}
  ogType="article"
  structuredData={structuredData}
  htmlLang="en"
  ogLocale="en_US"
  preloadConceptFont
  skipLabel="Skip to main content"
  alternates={alternates}
>
  <div class={`container explore-detail${interactive ? ' explore-detail--interactive' : ''}`}>
    <div class="detail-top-nav">
      <Breadcrumb
        label="Breadcrumb"
        items={[
          { label: 'Home', href: '/en/' },
          { label: 'Exams', href: '/en/exam' },
          { label: entry.data.title },
        ]}
      />
      <a href="/en/exam" class="back-link back-link--top">← Back to exams</a>
    </div>

    <header class="page-header">
      <p class="exam-source-label">{sourceLabel}</p>
      <h1>{entry.data.title}</h1>
      <div class="tag-list">
        <span class="tag">{entry.data.unit}</span>
        {entry.data.topics.map((topic) => <span class="tag">{topic}</span>)}
      </div>
      {
        entry.data.sourceUrl ? (
          <p class="exam-source-links">
            <a href={entry.data.sourceUrl} rel="noopener noreferrer" target="_blank">
              {sourceLinkLabels.source}
            </a>
            {entry.data.analysisUrl ? (
              <a href={entry.data.analysisUrl} rel="noopener noreferrer" target="_blank">
                {sourceLinkLabels.analysis}
              </a>
            ) : null}
          </p>
        ) : null
      }
      {creditLine ? <p class="exam-source-credit">{creditLine}</p> : null}
      <ConceptTags slugs={entry.data.concepts} locale="en" />
    </header>

    {
      interactive ? (
        <ExamInteractiveStage client:only="react" slug={entry.id} locale="en">
          <div
            slot="fallback"
            class="interactive-loading interactive-loading--explore"
            role="status"
            aria-live="polite"
            aria-label="Loading the figure"
          >
            <span class="interactive-loading__mark"></span>
          </div>
        </ExamInteractiveStage>
      ) : (
        <CanvasPlaceholder class="interactive-canvas" />
      )
    }

    <article class="prose">
      <Content />
    </article>

    <RelatedLinks items={relatedItems} locale="en" />

    <Giscus locale="en" />
    <FitKatexDisplay />

    <a href="/en/exam" class="back-link">← Back to exams</a>
  </div>
</BaseLayout>

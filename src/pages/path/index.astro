---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { learningPaths } from '../../lib/learningPaths';
import { siteSeo } from '../../lib/seoCopy';
import '../../styles/pages/path.css';

const site = Astro.site ?? Astro.url;
const siteRoot = new URL('/', site).href;
const pageUrl = new URL('/path', site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: siteRoot },
      { '@type': 'ListItem', position: 2, name: '策展路徑', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: siteSeo.path.title,
    description: siteSeo.path.description,
    itemListElement: learningPaths.map((path, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: path.title,
      item: new URL(`/path/${path.slug}`, site).href,
    })),
  },
];
---

<BaseLayout
  title={siteSeo.path.title}
  description={siteSeo.path.description}
  ogType="website"
  structuredData={structuredData}
>
  <div class="container path-index">
    <div class="detail-top-nav">
      <Breadcrumb items={[{ label: '首頁', href: '/' }, { label: '策展路徑' }]} />
    </div>

    <header class="page-header">
      <h1>策展路徑</h1>
      <p class="page-lead">{siteSeo.path.description}</p>
    </header>

    <ul class="path-index-list">
      {
        learningPaths.map((path) => (
          <li>
            <a class="path-index-card" href={`/path/${path.slug}`}>
              <h2 class="path-index-card__title">{path.title}</h2>
              <p class="path-index-card__desc">{path.description}</p>
              <span class="path-index-card__cta">{path.steps.length} 步 →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
